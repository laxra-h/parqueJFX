<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="580.0" prefWidth="780.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.parquejfx.viewController.AdminAtraccionesViewController">
   <children>
      <HBox layoutX="88.0" layoutY="91.0" prefHeight="100.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="300.0" prefWidth="300.0">
               <content>
                  <VBox minWidth="300.0" prefHeight="740.0" prefWidth="300.0" spacing="10.0" styleClass="card-oscura">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <Label styleClass="titulo-login" text="Gestionar Atracción" />
                        <Separator prefWidth="200.0" styleClass="separador-login" />
                        <VBox prefHeight="200.0" prefWidth="100.0" spacing="4.0">
                           <children>
                              <Label styleClass="campo-label-login" text="Nombre" />
                              <TextField fx:id="txtNombreAtr" promptText="Ej: Montaña Rusa" styleClass="text-field" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label styleClass="campo-label-login" text="Código" />
                              <TextField fx:id="txtCodigoAtr" promptText="Ej: 001" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" spacing="4.0">
                           <children>
                              <Label styleClass="campo-label-login" text="Capacidad máxima" />
                              <TextField fx:id="txtCapacidadAtr" promptText="Ej: 20" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" spacing="4.0">
                           <children>
                              <Label styleClass="campo-label-login" text="Estatura mínima" />
                              <TextField fx:id="txtEstaturaAtr" promptText="Ej: 1.40" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" spacing="4.0">
                           <children>
                              <Label styleClass="campo-label-login" text="Edad mínima" />
                              <TextField fx:id="txtEdadAtr" promptText="Ej: 10" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" spacing="4.0">
                           <children>
                              <Label styleClass="campo-label-login" text="Costo adicional" />
                              <TextField fx:id="txtCostoAtr" promptText="Ej: 5000" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" spacing="4.0">
                           <children>
                              <Label styleClass="campo-label-login" text="Tipo" />
                              <ComboBox fx:id="cmbTipoAtr" prefWidth="260.0" />
                           </children>
                        </VBox>
                        <VBox prefHeight="26.0" prefWidth="248.0" spacing="4.0">
                           <children>
                              <Label styleClass="campo-label-login" text="Zona" />
                              <ComboBox fx:id="cmbZonaAtr" prefWidth="260.0" />
                           </children>
                        </VBox>
                        <Label fx:id="lblMensajeAtr" styleClass="mensaje-error" />
                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="8.0">
                           <children>
                              <Button fx:id="btnGuardarAtr" mnemonicParsing="false" onAction="#guardarAtraccion" prefHeight="38.0" prefWidth="75.0" styleClass="btn-login" text="Guardar" />
                              <Separator orientation="VERTICAL" prefHeight="38.0" />
                              <Button fx:id="btnLimpiarAtr" mnemonicParsing="false" onAction="#limpiarAtr" prefHeight="38.0" prefWidth="75.0" styleClass="btn-login" text="Limpiar" />
                           </children>
                        </HBox>
                        <Button fx:id="btnEliminarAtr" mnemonicParsing="false" onAction="#eliminarAtraccion" prefWidth="260.0" styleClass="btn-peligro" text="🗑 Eliminar seleccionada" />
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" styleClass="area-central" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label styleClass="card-titulo" text="Atracciones registradas" />
                  <TableView fx:id="tablaAtracciones" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colNombreAtr" prefWidth="130.0" text="Nombre" />
                      <TableColumn fx:id="colZonaAtr" prefWidth="100.0" text="Zona" />
                        <TableColumn fx:id="colTipoAtr" text="Tipo" />
                        <TableColumn fx:id="colEstadoAtr" text="Estado" />
                        <TableColumn fx:id="colCapacidadAtr" prefWidth="70.0" text="Capacidad" />
                        <TableColumn fx:id="colEstaturaAtr" prefWidth="85.0" text="Estatura mín." />
                    </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
