<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500" prefWidth="800" styleClass="fondo-login" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.parquejfx.viewController.InicioViewController">
   <children>
      <AnchorPane prefHeight="500.0" prefWidth="800.0">
         <children>
            <HBox layoutX="186.0" layoutY="182.0" prefHeight="100.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <children>
                  <AnchorPane minWidth="-Infinity" prefHeight="500.0" prefWidth="250.0" style="-fx-background-color: #cccccc;">
                     <children>
                        <ImageView fx:id="imgParque" fitHeight="500.0" fitWidth="250.0" layoutX="-1.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                     </children>
                  </AnchorPane>
                  <AnchorPane prefHeight="500.0" prefWidth="550.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="TOP_CENTER" layoutX="142.0" layoutY="110.0" prefHeight="35.0" prefWidth="200.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                           <children>
                              <Label fx:id="lblDireccion" text="DIRECCION:" textFill="#696666">
                                 <font>
                                    <Font size="21.0" />
                                 </font>
                              </Label>
                              <Pane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                              <Label fx:id="lbAforo" prefHeight="31.0" prefWidth="80.0" text="AFORO: " textAlignment="JUSTIFY" textFill="#767373">
                                 <font>
                                    <Font size="21.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <VBox alignment="TOP_CENTER" layoutX="194.0" layoutY="190.0" prefHeight="200.0" prefWidth="100.0" spacing="50.0" styleClass="card-login" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="50.0">
                           <children>
                              <Label fx:id="lblNombreParque" text="TECH-PARK UQ" textFill="#dcd9d9">
                                 <font>
                                    <Font name="System Bold" size="62.0" />
                                 </font>
                              </Label>
                              <Label text="Selecciona tu rol" textFill="#8c8c8c">
                                 <font>
                                    <Font size="28.0" />
                                 </font>
                              </Label>
                              <Button fx:id="btnVisitante" mnemonicParsing="false" onAction="#irAVisitante" prefHeight="45.0" prefWidth="220.0" styleClass="btn-login" text="Soy Visitante" textFill="RED">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Button>
                              <Button fx:id="btnAdministrador" mnemonicParsing="false" onAction="#irAAdministrador" prefHeight="45.0" prefWidth="220.0" styleClass="btn-login" text="Soy Administrador" textFill="RED">
