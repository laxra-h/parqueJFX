                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Button>
                              <Button fx:id="btnOperador" mnemonicParsing="false" onAction="#irAOperador" prefHeight="45.0" prefWidth="220.0" styleClass="btn-login" text="Soy Operador" textFill="RED">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Button>
