      <Button fx:id="btnOk" layoutX="219.0" layoutY="299.0" mnemonicParsing="false" onAction="#clickearOk" prefHeight="42.0" prefWidth="80.0" styleClass="btn-login" text="Ok" />
      <Label fx:id="lblInfoAdicional" layoutX="107.0" layoutY="149.0" prefHeight="130.0" prefWidth="305.0" styleClass="acento-rojo" text="Información adicional: " textAlignment="JUSTIFY" textFill="#3dd60b" />
