            <Font name="Arial Bold" size="13.0" />
         </font>
      </Label>
      <Button fx:id="btnOk" layoutX="221.0" layoutY="278.0" mnemonicParsing="false" onAction="#clickearOk" prefHeight="42.0" prefWidth="80.0" styleClass="btn-login" text="Ok" />
      <Label fx:id="lblCausaError" layoutX="175.0" layoutY="186.0" prefHeight="21.0" prefWidth="171.0" styleClass="acento-rojo" text="Error: " textAlignment="JUSTIFY" textFill="#d70909" />
